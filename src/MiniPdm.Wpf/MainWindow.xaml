<Window x:Class="MiniPdm.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       
        Title="Мини-PDM — Состав изделия" Height="760" Width="1250" MinHeight="600" MinWidth="1000">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Импорт CAD" Command="{Binding ImportCommand}" Padding="16,7" Margin="0,0,8,0"/>
                <Button Content="Обновить" Command="{Binding LoadAssembliesCommand}" Padding="16,7"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                <Button Content="Поиск" Command="{Binding SearchCommand}" Padding="12,7"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Сборки" Grid.Column="0" Margin="0,0,8,0">
                <ListBox ItemsSource="{Binding Assemblies}" SelectedItem="{Binding SelectedAssembly, Mode=TwoWay}" DisplayMemberPath="Name"/>
            </GroupBox>

            <GroupBox Header="Дерево состава" Grid.Column="1" Margin="0,0,8,0">
                <TreeView ItemsSource="{Binding Tree}" SelectedItemChanged="TreeView_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="  ×"/>
                                <TextBlock Text="{Binding Quantity}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Карточка объекта" Grid.Row="0" Margin="0,0,0,8">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Наименование"/><TextBlock Grid.Column="1" Text="{Binding SelectedObject.Name}"/>
                        <TextBlock Grid.Row="1" Text="Обозначение"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedObject.Designation}"/>
                        <TextBlock Grid.Row="2" Text="Версия"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VersionText}"/>
                        <TextBlock Grid.Row="3" Text="Состояние"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StateText}"/>
                        <TextBlock Grid.Row="4" Text="Материал"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MaterialText}"/>
                        <TextBlock Grid.Row="5" Text="Масса"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MassText}"/>
                    </Grid>
                </GroupBox>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Утвердить" Command="{Binding ApproveCommand}" Padding="12,6" Margin="0,0,6,0"/>
                    <Button Content="Аннулировать" Command="{Binding CancelCommand}" Padding="12,6" Margin="0,0,6,0"/>
                    <Button Content="Рассчитать массу" Command="{Binding CalculateMassCommand}" Padding="12,6" Margin="0,0,6,0"/>
                    <Button Content="Спецификация" Command="{Binding LoadSpecificationCommand}" Padding="12,6"/>
                </StackPanel>

                <TabControl Grid.Row="2">
                    <TabItem Header="Спецификация">
                        <DataGrid ItemsSource="{Binding Specification}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Обозначение" Binding="{Binding Designation}" Width="170"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding ObjectType}" Width="100"/>
                                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="90"/>
                                <DataGridTextColumn Header="Масса, кг" Binding="{Binding MassKg}" Width="90"/>
                                <DataGridTextColumn Header="Итого, кг" Binding="{Binding TotalMassKg}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Результат расчёта">
                        <TextBlock Text="{Binding MassResult}" TextWrapping="Wrap" Margin="12"/>
                    </TabItem>
                    <TabItem Header="Поиск">
                        <ListBox ItemsSource="{Binding SearchResults}" DisplayMemberPath="Name"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
